# ==============================================================================
# T.I.M.E.S Telegram Assistant Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file to version control (GitHub/Git).
# ==============================================================================

# --- Telegram Bot Configuration (Required) ---
# Obtain from @BotFather on Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Your personal Telegram User ID for authorization/security (only this user can use the bot)
# Send /start to @userinfobot or @raw_data_bot on Telegram to get your numeric ID
AUTHORIZED_USER_ID=

# --- Google Gemini AI (Required) ---
# API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-2.5-flash or gemini-3-flash-preview)
GEMINI_MODEL=gemini-2.5-flash

# --- Google Calendar OAuth (Required for Calendar) ---
# Path to OAuth 2.0 Client credentials downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json

# Local file where OAuth access/refresh token will be saved automatically after sign-in
GOOGLE_TOKEN_FILE=token.json

# --- Notion API Configuration (Optional - for Tasks) ---
# Internal Integration Token from https://www.notion.so/profile/integrations (starts with secret_ or ntn_)
NOTION_API_KEY=

# Notion Database ID for task storage (found in your Notion database share URL)
NOTION_DATABASE_ID=

# --- General Settings ---
# Local SQLite database file
DATABASE_FILE=calendar_bot.db

# IANA Timezone string (e.g. Asia/Kolkata, America/New_York, Europe/London)
TIMEZONE=Asia/Kolkata

# Logging detail (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Daily Morning Briefing ---
# Automatically sends a morning audio & text summary of the day's events and tasks
BRIEFING_ENABLED=true
BRIEFING_TIME=08:00

# --- Voice & Text-to-Speech (TTS) Settings ---
# Send voice notes to Telegram for alerts & briefings
TTS_PHONE_VOICE_ENABLED=true

# Announce reminders via local PC speakers (useful if running on a desktop/home server)
TTS_COMPUTER_SPEAKER_ENABLED=false
TTS_VOICE_RATE=175
